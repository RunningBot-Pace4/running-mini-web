generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum EventType {
  RUNNING
  HYROX
  REDLINE
  MARATHON
  TRAINING
  RECOVERY
  OTHER
}

enum VoteStatus {
  ATTEND
  NOT_ATTEND
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RewardType {
  ITEM
  VOUCHER
}

enum TierLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum RedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  passwordHash    String
  role            Role             @default(USER)
  stravaAthleteId BigInt?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sessions        Session[]
  passwordResetTokens PasswordResetToken[]
  stravaToken     StravaToken?
  createdEvents   Event[]          @relation("EventCreatedBy")
  votes           EventVote[]
  activities      StravaActivity[]
  submissions     Submission[]
  redemptions     Redemption[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StravaToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  athleteId    BigInt   @unique
  accessToken  String
  refreshToken String
  expiresAt    Int
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String?
  type        EventType    @default(RUNNING)
  startAt     DateTime
  endAt       DateTime
  status      EventStatus  @default(OPEN)
  manualOpenAt DateTime?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy   User         @relation("EventCreatedBy", fields: [createdById], references: [id])
  votes       EventVote[]
  submissions Submission[]

  @@index([status])
  @@index([type])
  @@index([startAt, endAt])
}

model EventVote {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    VoteStatus
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status])
}

model StravaActivity {
  id             String       @id @default(cuid())
  userId         String
  stravaId       BigInt
  name           String
  type           String
  sportType      String?
  distanceMeters Float
  movingTimeSec  Int
  elapsedTimeSec Int?
  startDate      DateTime
  rawJson        Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions    Submission[]

  @@unique([userId, stravaId])
  @@index([userId, startDate])
  @@index([type])
}

model Submission {
  id               String           @id @default(cuid())
  eventId          String
  userId           String
  activityId       String
  distanceKm       Decimal          @db.Decimal(10, 2)
  attendancePoints Int              @default(1)
  distancePoints   Int
  totalPoints      Int
  status           SubmissionStatus @default(APPROVED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity         StravaActivity   @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([eventId, userId, activityId])
  @@index([eventId, status])
  @@index([userId])
}


model Reward {
  id            String       @id @default(cuid())
  name          String
  type          RewardType
  description   String?
  costPoints    Int
  minTier       TierLevel    @default(BRONZE)
  stockQuantity Int?
  voucherCode   String?
  imageDataUrl  String?      @db.Text
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  redemptions   Redemption[]

  @@index([isActive, type])
  @@index([minTier])
  @@index([costPoints])
}

model Redemption {
  id          String           @id @default(cuid())
  userId      String
  rewardId    String
  status      RedemptionStatus @default(PENDING)
  pointsCost  Int
  quantity    Int              @default(1)
  requestNote String?
  adminNote   String?
  approvedAt  DateTime?
  fulfilledAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward      Reward           @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([rewardId, status])
  @@index([createdAt])
}


model ScoreSetting {
  id               String   @id @default(cuid())
  key              String   @unique
  attendancePoints Int      @default(1)
  perKmPoints      Int      @default(2)
  requireSubmissionApproval Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


model SiteContent {
  id               String   @id @default(cuid())
  key              String   @unique
  brandName        String   @default("Run Mini")
  brandMark        String   @default("↗")
  logoImageDataUrl String?  @db.Text
  themePreset      String   @default("coastal-sunrise")
  themePrimary     String   @default("#1d6fa3")
  themeSecondary   String   @default("#ff7a45")
  themeBackground  String   @default("#f8fbfd")
  themeDark        String   @default("#0b1f33")
  heroEyebrow      String
  heroTitle        String
  heroDescription  String   @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
